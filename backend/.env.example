# ===== 基础 =====
# 调试模式（生产建议 False）
DEBUG=true
# 数据库：开发默认 SQLite；生产可改为 postgresql+psycopg2://user:pass@localhost/kb
DATABASE_URL=sqlite:///./data/kb.db
# 数据目录（文档原件、向量/图谱本地回退持久化）
DATA_DIR=data
# JWT 密钥（生产必须改为随机长字符串）
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_MINUTES=720

# ===== 管理员初始账号（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== Embedding（OpenAI 兼容嵌入服务，必填）=====
# 配置教程（各厂商示例/维度对照/常见问题）：见仓库 docs/embedding-config-tutorial.md
# 模式: openai（云端/本地 OpenAI 兼容服务）| dummy（离线占位，仅调试，检索无语义）
EMBEDDING_MODE=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=16
# 指令式嵌入模型（如 Qwen3-Embedding）推荐的前后缀；普通模型留空
# 例（本地 Ollama 的 OpenAI 兼容接口）：
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   EMBEDDING_API_KEY=ollama  EMBEDDING_MODEL=qwen3-embedding:8b-q4_K_M
#   EMBEDDING_DIM=4096  EMBEDDING_QUERY_PREFIX="query: "  EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# ===== 云端大模型（OpenAI 兼容，用于查询理解层/图谱抽取/聚合生成，必填）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 接口风格：openai（云端兼容接口）| ollama_native（本地 Ollama 原生，qwen3 系思考模型用）
LLM_API_STYLE=openai

# ===== 向量库 =====
# 后端: local（开发/单机回退）| qdrant
VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333

# ===== 图数据库 =====
# 后端: local（开发/单机回退）| neo4j
GRAPH_BACKEND=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ===== 流水线默认参数 =====
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
GRAPH_EXTRACTION_ENABLED=true
GRAPH_BATCH_CHUNKS=8

# ===== MCP Server（Streamable HTTP，供 Claude/Cursor/Dify 等调用）=====
MCP_ENABLED=true
